---
import type { Gericht } from "../data/speisekarte";
interface Props { g: Gericht }
const { g } = Astro.props;
const badges = [
  g.beliebt && { t: "Beliebt", c: "bg-red text-white" },
  g.vegan && { t: "Vegan", c: "bg-emerald-700 text-white" },
  g.vegetarisch && !g.vegan && { t: "Vegetarisch", c: "bg-emerald-50 text-emerald-800 ring-1 ring-emerald-700/25" },
  g.scharf && { t: "Scharf", c: "bg-orange-50 text-orange-800 ring-1 ring-orange-700/25" },
].filter(Boolean) as { t: string; c: string }[];
---

{badges.length > 0 && (
  <span class="inline-flex flex-wrap gap-1.5 align-middle">
    {badges.map((b) => <span class:list={["rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider", b.c]}>{b.t}</span>)}
  </span>
)}
