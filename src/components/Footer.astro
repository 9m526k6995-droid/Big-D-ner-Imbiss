---
import { site } from '../config/site';
import { nav } from '../data/nav';
import { telHref, mailHref, socialLinks } from '../lib/site-helpers';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import OpeningHoursTable from './OpeningHoursTable.astro';
---

<footer class="bg-ink-900 text-cream-200" data-dark>
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.1fr_0.8fr_1.4fr_1fr_1fr] lg:gap-8 lg:py-16">
    <div class="lg:col-span-1">
      <a href="/" class="flex items-center gap-3 text-cream-50" aria-label={`${site.name} – zur Startseite`}>
        <Logo dark />
      </a>
      <p class="mt-4 max-w-xs text-[0.95rem] leading-relaxed text-cream-300">
        Döner, Pizza, Pide, Lahmacun und Falafel in der Spitalhofstraße – {site.address.landmark}.
      </p>
    </div>

    <div>
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-gold-400">Navigation</h2>
      <ul class="mt-4 space-y-2.5 text-[0.95rem]">
        {nav.map((n) => <li><a href={n.href} class="transition-colors hover:text-cream-50">{n.label}</a></li>)}
      </ul>
    </div>

    <div class="lg:col-span-1">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-gold-400">Öffnungszeiten</h2>
      <div class="mt-2 text-[0.9rem]"><OpeningHoursTable dark /></div>
    </div>

    <div>
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-gold-400">Kontakt</h2>
      <address class="mt-4 space-y-3 text-[0.95rem] not-italic">
        <p>{site.name}<br />{site.address.street}<br />{site.address.zip} {site.address.city}<br /><span class="text-cream-300">{site.address.landmark}</span></p>
        <p><a href={telHref} class="inline-flex items-center gap-2 text-cream-50 hover:text-gold-400"><Icon name="phone" class="h-4 w-4" />{site.phone.display}</a></p>
        <p><a href={mailHref} class="inline-flex items-center gap-2 break-all hover:text-cream-50"><Icon name="mail" class="h-4 w-4 shrink-0" />{site.email}</a></p>
      </address>
    </div>

    <div>
      <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-gold-400">Social Media</h2>
      {
        socialLinks.length > 0 ? (
          <ul class="mt-4 space-y-2.5 text-[0.95rem]">
            {socialLinks.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-cream-50">
                  <Icon name={s.id} class="h-4 w-4" />
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 text-[0.95rem] text-cream-300">–</p>
        )
      }
    </div>
  </div>

  <div class="border-t border-cream-50/10">
    <div class="container-page flex flex-col gap-3 py-6 text-sm text-cream-300 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {site.name}, {site.address.city}</p>
      <ul class="flex gap-5">
        <li><a href="/impressum" class="hover:text-cream-50">Impressum</a></li>
        <li><a href="/datenschutz" class="hover:text-cream-50">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>
