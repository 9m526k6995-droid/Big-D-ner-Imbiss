---
/**
 * Zeigt ein Foto aus fotos/ (Dateiname mit Endung).
 * Fehlt die Datei, erscheint automatisch ein schöner Platzhalter statt eines kaputten Bildes.
 */
import { Picture } from "astro:assets";
import { fotoDatei } from "../lib/fotos";
import FotoPlatzhalter from "./FotoPlatzhalter.astro";

interface Props {
  datei?: string | null;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  position?: string; // object-position, z. B. "50% 30%"
  platzhalter?: string;
}
const { datei, alt, sizes = "(min-width: 1024px) 33vw, 100vw", eager = false, class: klasse = "", position, platzhalter } = Astro.props;
const bild = fotoDatei(datei);
---

{
  bild ? (
    <Picture
      src={bild}
      alt={alt}
      formats={["avif", "webp"]}
      widths={[360, 560, 780, bild.width]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding={eager ? "sync" : "async"}
      class:list={["h-full w-full object-cover", klasse]}
      style={position ? `object-position:${position}` : undefined}
    />
  ) : (
    <FotoPlatzhalter text={platzhalter} class={klasse} />
  )
}
