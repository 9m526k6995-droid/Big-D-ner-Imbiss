---
import Icon from "./Icon.astro";
import { site, telHref } from "../config/site";

/** Hauptnavigation – hier Menüpunkte ändern. */
const nav = [
  { href: "/", label: "Start" },
  { href: "/speisekarte", label: "Speisekarte" },
  { href: "/ueber-uns", label: "Über uns" },
  { href: "/kontakt", label: "Kontakt" },
];
const pfad = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/95 text-white backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="shrink-0" aria-label={`${site.name} – Startseite`}>
      <img src="/logo-weiss.svg" alt="" width="105" height="44" class="h-11 w-auto" />
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Hauptnavigation">
      {nav.map((n) => (
        <a href={n.href} aria-current={pfad === n.href ? "page" : undefined} class="text-[15px] font-medium text-white/80 transition hover:text-white aria-[current=page]:text-white aria-[current=page]:underline aria-[current=page]:decoration-red aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8">{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href={telHref} class="btn btn-red !min-h-10 !px-4 !py-2 text-sm"><Icon name="phone" class="h-4 w-4" /><span class="hidden sm:inline">{site.telefon.anzeige}</span><span class="sm:hidden">Anrufen</span></a>
      <button type="button" data-menu-button aria-expanded="false" aria-controls="mobilmenue" aria-label="Menü öffnen" class="grid h-10 w-10 place-items-center rounded-full border border-white/25 md:hidden">
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <div id="mobilmenue" data-menu hidden class="fixed inset-x-0 top-16 z-40 h-[calc(100dvh-4rem)] overflow-y-auto bg-ink px-6 pb-10 pt-6 md:hidden">
    <nav aria-label="Mobile Navigation" class="flex flex-col">
      {nav.map((n) => (
        <a href={n.href} class="border-b border-white/10 py-5 font-display text-4xl uppercase tracking-wide">{n.label}</a>
      ))}
    </nav>
    <div class="mt-8 grid gap-3">
      <a href={telHref} class="btn btn-red"><Icon name="phone" />Jetzt telefonisch vorbestellen</a>
      <a href={site.route} class="btn btn-ghost" rel="noopener" target="_blank"><Icon name="route" />Route starten</a>
    </div>
    <p class="mt-8 text-sm text-white/60">{site.adresse.strasse}, {site.adresse.plz} {site.adresse.ort}<br />{site.adresse.orientierung}</p>
  </div>
</header>
