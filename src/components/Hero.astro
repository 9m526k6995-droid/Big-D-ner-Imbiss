---
import { site } from '../config/site';
import { ratingText, routeUrl } from '../lib/site-helpers';
import Pic from './Pic.astro';
import Button from './Button.astro';
import Stars from './Stars.astro';
---

<section class="relative isolate overflow-hidden bg-ink-900 text-cream-50">
  <Pic datei="doener-box-ayran.jpg" alt="Döner-Box mit Pommes und Joghurtsoße von Big Döner Imbiss" priority sizes="100vw" class="absolute inset-0 -z-20 block h-full w-full" imgClass="h-full w-full object-cover" position="60% 50%" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-900/90 via-ink-900/65 to-ink-900/15 max-md:bg-gradient-to-t max-md:from-ink-900/95 max-md:via-ink-900/70 max-md:to-ink-900/35"></div>

  <div class="container-page flex min-h-[34rem] flex-col justify-end pb-14 pt-24 sm:min-h-[40rem] sm:pb-20 lg:min-h-[44rem] lg:justify-center lg:pb-24">
    <p class="eyebrow !text-gold-400">Spitalhofstraße 95 · {site.address.landmark}</p>
    <h1 class="mt-4 max-w-3xl text-balance text-[2.6rem] font-medium leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
      Big Döner <span class="text-gold-400">in Passau</span>
    </h1>
    <p class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-cream-200 sm:text-xl">
      Döner, Pizza, Pide, Lahmacun und Falafel – mit täglich frisch gebackenem Brot.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href="/speisekarte" variant="secondary" size="lg" icon="utensils">Speisekarte ansehen</Button>
      <Button href={routeUrl} variant="outline-light" size="lg" icon="route" external>Route planen</Button>
    </div>
    <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.95rem] text-cream-200">
      <Stars class="h-[1.05rem] w-[1.05rem]" />
      <span><strong class="font-semibold text-cream-50">{ratingText}</strong> bei Google</span>
      <span class="text-cream-300">· {site.google.reviewCount} Bewertungen</span>
    </p>
  </div>
</section>
