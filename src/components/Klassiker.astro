---
import Foto from "./Foto.astro";

/** Kacheln „Unsere Klassiker“ – Foto per Dateiname austauschen. */
const kacheln = [
  { titel: "Döner", text: "Vom Spieß, im frischen Brot", datei: "doener-spiess.jpg", alt: "Frischer Dönerspieß im Grill", anker: "doener" },
  { titel: "Dürüm", text: "Gerollt, saftig, satt", datei: "falafel-dueruem-01.jpg", alt: "Offener Dürüm-Fladen mit Falafel und Salat", anker: "dueruem" },
  { titel: "Box & Teller", text: "Mit Pommes und Salat", datei: "doener-box-ayran.jpg", alt: "Döner-Box mit Pommes und Ayran", anker: "box-teller" },
  { titel: "Pizza", text: "Dünn, knusprig, dick belegt", datei: "pizza-thunfisch.jpg", alt: "Pizza mit Thunfisch, Mais und Zwiebeln", anker: "pizza" },
  { titel: "Pide", text: "Aus dem Ofen, mit Soße", datei: "pide-01.jpg", alt: "Pide mit Joghurtsoße und Basilikum", anker: "pide" },
  { titel: "Lahmacun", text: "Dünn, würzig, mit Petersilie", datei: "lahmacun-01.jpg", alt: "Lahmacun auf einem Holzbrett", anker: "lahmacun" },
  { titel: "Falafel", text: "Vegetarisch und frisch", datei: "falafel-dueruem-02.jpg", alt: "Falafel-Dürüm wird belegt", anker: "falafel" },
];
---

<section class="section bg-paper" id="klassiker">
  <div class="container-x">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Unsere Klassiker</p>
      <h2 class="h2">Was bei uns auf den Tisch kommt</h2>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {kacheln.map((k, i) => (
        <li class:list={["reveal", i === 0 && "col-span-2 lg:col-span-2 lg:row-span-2", i >= 5 && "lg:col-span-2"]} style={`--d:${(i % 4) * 70}ms`}>
          <a href={`/speisekarte#${k.anker}`} class="zoom group relative block h-full min-h-[200px] overflow-hidden rounded-2xl bg-ink shadow-card sm:min-h-[260px]">
            <div class:list={["absolute inset-0", i === 0 && "lg:min-h-[540px]"]}>
              <Foto datei={k.datei} alt={k.alt} sizes={i === 0 ? "(min-width: 1024px) 560px, 100vw" : "(min-width: 1024px) 280px, 50vw"} />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/20 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-4 text-white sm:p-5">
              <h3 class:list={["text-2xl sm:text-3xl", i === 0 && "lg:text-5xl"]}>{k.titel}</h3>
              <p class="text-sm text-white/80">{k.text}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
