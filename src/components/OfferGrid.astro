---
import { offer } from '../data/offer';
import Pic from './Pic.astro';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section class="section" id="angebot">
  <div class="container-page">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading eyebrow="Unser Angebot" title="Frisch zubereitet, jeden Tag" text="Döner und Dürüm vom Hühner- und Putenspieß, dazu Pizza, Pide, Lahmacun und Falafel." />
      <a href="/speisekarte" class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap font-medium text-ink-900 underline decoration-gold-500 decoration-2 underline-offset-8 hover:text-gold-700">
        Gesamte Speisekarte <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
      {
        offer.map((o) => (
          <li class="reveal">
            <a href={`/speisekarte#${o.id}`} class="group card card-hover block overflow-hidden">
              <Pic datei={o.image} alt={o.alt} sizes="(min-width:1024px) 400px, (min-width:640px) 45vw, 50vw" class="block aspect-[4/3] overflow-hidden bg-cream-200" imgClass="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" position={o.position} />
              <div class="p-4 sm:p-5">
                <h3 class="font-display text-xl sm:text-2xl">{o.title}</h3>
                <p class="mt-1 hidden text-[0.95rem] text-ink-600 sm:block">{o.text}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
