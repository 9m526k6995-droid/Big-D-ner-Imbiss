---
interface Props { titel: string }
const { titel } = Astro.props;
---

<section class="bg-ink pb-12 pt-14 text-white sm:pt-20"><div class="container-x"><h1 class="text-5xl sm:text-7xl">{titel}</h1></div></section>
<article class="container-x max-w-3xl py-12 sm:py-16 [&_a]:font-medium [&_a]:text-red-dark [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mb-3 [&_h2]:mt-10 [&_h2]:font-sans [&_h2]:text-xl [&_h2]:font-bold [&_h2]:normal-case [&_h2]:tracking-normal [&_p]:mb-4 [&_p]:leading-relaxed [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6">
  <slot />
</article>
