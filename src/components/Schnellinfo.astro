---
import Icon from "./Icon.astro";
import { site, telHref, zeitenGruppen } from "../config/site";
const kurz = zeitenGruppen().filter((g) => g.text !== "geschlossen").map((g) => `${g.label.replace("Montag–Freitag", "Mo–Fr").replace("Samstag", "Sa")} ${g.text.replace(" Uhr", "")}`).join(" · ");
---

<section aria-label="Schnellinfo" class="relative z-10 bg-red text-white">
  <div class="container-x">
    <ul class="grid divide-white/20 sm:grid-cols-2 sm:divide-x lg:grid-cols-4 [&>li]:border-b [&>li]:border-white/20 lg:[&>li]:border-b-0">
      <li class="flex items-start gap-3 py-5 sm:px-5 sm:first:pl-0">
        <Icon name="pin" class="mt-0.5 h-6 w-6 shrink-0" />
        <p class="text-[15px] leading-snug"><strong class="block text-base">{site.adresse.strasse}</strong>{site.adresse.plz} {site.adresse.ort} · {site.adresse.orientierung}</p>
      </li>
      <li class="flex items-start gap-3 py-5 sm:px-5">
        <Icon name="phone" class="mt-0.5 h-6 w-6 shrink-0" />
        <p class="text-[15px] leading-snug"><a href={telHref} class="block text-base font-bold hover:underline">{site.telefon.anzeige}</a>Telefonisch vorbestellen</p>
      </li>
      <li class="flex items-start gap-3 py-5 sm:px-5">
        <Icon name="clock" class="mt-0.5 h-6 w-6 shrink-0" />
        <p class="text-[15px] leading-snug"><strong class="block text-base" data-status data-offen="false">{kurz}</strong><a href="#standort" class="hover:underline">Öffnungszeiten ansehen</a></p>
      </li>
      <li class="flex items-start gap-3 py-5 sm:px-5 lg:pr-0">
        <Icon name="car" class="mt-0.5 h-6 w-6 shrink-0" />
        <p class="text-[15px] leading-snug"><strong class="block text-base">Kostenlose Parkplätze</strong>direkt vor Ort</p>
      </li>
    </ul>
  </div>
</section>
