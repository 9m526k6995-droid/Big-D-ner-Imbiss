---
import Foto from "./Foto.astro";
import Icon from "./Icon.astro";
import Oeffnungszeiten from "./Oeffnungszeiten.astro";
import { site, telHref } from "../config/site";
---

<section class="section bg-sand" id="standort">
  <div class="container-x">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Standort & Öffnungszeiten</p>
      <h2 class="h2">Gegenüber vom PaWo-Center</h2>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
      <div class="reveal zoom relative aspect-[4/3] overflow-hidden rounded-[2rem] shadow-card lg:aspect-auto lg:min-h-full">
        <Foto datei="aussen-01.jpg" alt="Der Pavillon von Big Döner mit rotem Dach an der Spitalhofstraße" sizes="(min-width: 1024px) 640px, 100vw" />
        <div class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full bg-white/95 px-4 py-2 text-sm font-semibold text-ink shadow">
          <span data-status-dot class="h-2.5 w-2.5 rounded-full bg-red"></span><span data-status>Öffnungszeiten unten</span>
        </div>
      </div>
      <div class="reveal flex flex-col gap-6 rounded-[2rem] bg-paper p-6 shadow-card sm:p-8" style="--d:100ms">
        <div class="space-y-4">
          <p class="flex items-start gap-3"><Icon name="pin" class="mt-0.5 h-6 w-6 shrink-0 text-red" /><span><strong class="block">{site.adresse.strasse}, {site.adresse.plz} {site.adresse.ort}</strong><span class="text-muted">Eigener Pavillon mit rotem Dach, {site.adresse.orientierung}</span></span></p>
          <p class="flex items-start gap-3"><Icon name="car" class="mt-0.5 h-6 w-6 shrink-0 text-red" /><span><strong class="block">Kostenlose Parkplätze</strong><span class="text-muted">Einfach anhalten, abholen, weiterfahren.</span></span></p>
        </div>
        <div class="-mx-3"><Oeffnungszeiten /></div>
        <div class="mt-auto grid gap-3 sm:grid-cols-2">
          <a href={site.route} target="_blank" rel="noopener" class="btn btn-red"><Icon name="route" />Route starten</a>
          <a href={telHref} class="btn btn-outline"><Icon name="phone" />Anrufen</a>
        </div>
      </div>
    </div>
  </div>
</section>
