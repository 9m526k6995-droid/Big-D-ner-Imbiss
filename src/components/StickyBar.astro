---
/** Feste Leiste am unteren Rand (nur Handy): Anrufen / Speisekarte / Route. */
import Icon from "./Icon.astro";
import { site, telHref } from "../config/site";
---

<nav aria-label="Schnellzugriff" class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-ink/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden">
  <ul class="grid grid-cols-3 gap-2 p-2">
    <li><a href={telHref} class="flex h-14 flex-col items-center justify-center gap-0.5 rounded-xl bg-red text-xs font-semibold text-white"><Icon name="phone" class="h-5 w-5" />Anrufen</a></li>
    <li><a href="/speisekarte" class="flex h-14 flex-col items-center justify-center gap-0.5 rounded-xl text-xs font-semibold text-white ring-1 ring-white/25"><Icon name="menu" class="h-5 w-5" />Speisekarte</a></li>
    <li><a href={site.route} target="_blank" rel="noopener" class="flex h-14 flex-col items-center justify-center gap-0.5 rounded-xl text-xs font-semibold text-white ring-1 ring-white/25"><Icon name="route" class="h-5 w-5" />Route</a></li>
  </ul>
</nav>
