---
import { team } from '../data/team';
import Pic from './Pic.astro';
import Placeholder from './Placeholder.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="team">
  <div class="container-page">
    <SectionHeading eyebrow="Team" title="Unser Team" text="Die Menschen hinter der Theke – wir freuen uns auf euren Besuch." />
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5 lg:grid-cols-5">
      {
        team.map((m) => (
          <li class="reveal">
            <figure>
              {m.image ? (
                <Pic datei={m.image} alt={m.alt} sizes="(min-width:1024px) 230px, (min-width:640px) 30vw, 46vw" class="block aspect-[4/5] overflow-hidden rounded-2xl bg-cream-200" imgClass="h-full w-full object-cover" position={m.position} fallback="Foto folgt" />
              ) : (
                <Placeholder text="Foto folgt" icon="user" class="aspect-[4/5] rounded-2xl" />
              )}
              {(m.name || m.role) && (
                <figcaption class="mt-3">
                  {m.name && <span class="block font-display text-lg leading-tight">{m.name}</span>}
                  {m.role && <span class="block text-sm text-ink-600">{m.role}</span>}
                </figcaption>
              )}
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
