---
import Foto from "./Foto.astro";
import Icon from "./Icon.astro";
const punkte = ["Brot stets frisch gebacken", "Frische Zutaten, frischer Salat", "Freundlich, schnell, unkompliziert", "Kostenlose Parkplätze vor der Tür"];
---

<section class="section bg-paper" id="ueber-uns">
  <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="reveal relative">
      <div class="aspect-[4/3] overflow-hidden rounded-[2rem] shadow-card">
        <Foto datei="team-01.jpg" alt="Der Inhaber und seine Frau lächeln neben dem Dönerspieß" sizes="(min-width: 1024px) 560px, 100vw" position="50% 35%" />
      </div>
      <div class="absolute -bottom-5 left-5 rounded-2xl bg-red px-5 py-3 text-white shadow-xl sm:left-8">
        <p class="font-display text-2xl uppercase tracking-wide">Frisch &amp; freundlich</p>
      </div>
    </div>
    <div class="reveal">
      <p class="eyebrow">Über uns</p>
      <h2 class="h2">Ein kleiner Pavillon mit großem Spieß</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Unseren Pavillon mit dem roten Dach findest du direkt an der Spitalhofstraße. Wir stehen selbst am Spieß und an der Theke, backen das Brot frisch und belegen jede Pizza von Hand. Wer bei uns isst, soll sich willkommen fühlen.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {punkte.map((p) => <li class="flex items-start gap-3 text-[15px] font-medium"><span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-red/10 text-red"><Icon name="check" class="h-4 w-4" /></span>{p}</li>)}
      </ul>
      <a href="/ueber-uns" class="btn btn-outline mt-8">Mehr über uns<Icon name="arrow" /></a>
    </div>
  </div>
</section>
