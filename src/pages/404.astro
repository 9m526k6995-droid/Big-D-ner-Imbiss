---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Seite nicht gefunden | Big Döner Imbiss" noindex>
  <section class="section">
    <div class="container-page max-w-2xl text-center">
      <p class="eyebrow">Fehler 404</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Diese Seite gibt es nicht.</h1>
      <p class="mt-4 text-lg text-ink-600">Vielleicht hilft die Startseite oder ein Blick in unsere Speisekarte weiter.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/" icon="arrow">Zur Startseite</Button>
        <Button href="/speisekarte" variant="ghost">Speisekarte</Button>
      </div>
    </div>
  </section>
</Layout>
