---
import Base from "../layouts/Base.astro";
---

<Base title="Seite nicht gefunden | Big Döner Imbiss Passau" description="Diese Seite gibt es nicht. Zur Startseite oder zur Speisekarte von Big Döner in Passau.">
  <section class="bg-ink py-24 text-white sm:py-32">
    <div class="container-x text-center">
      <p class="font-display text-[8rem] leading-none text-red sm:text-[12rem]">404</p>
      <h1 class="mt-4 text-4xl sm:text-6xl">Hier gibt’s leider nichts</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-white/75">Die Seite ist nicht (mehr) da. Der Spieß dreht sich aber weiter.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-light">Zur Startseite</a>
        <a href="/speisekarte" class="btn btn-ghost">Zur Speisekarte</a>
      </div>
    </div>
  </section>
</Base>
