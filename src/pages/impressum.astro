---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site';
import { telHref, mailHref } from '../lib/site-helpers';
// Alle Angaben kommen aus src/config/site.ts.
---

<Layout title="Impressum | Big Döner Imbiss Passau" description="Impressum von Big Döner Imbiss, Spitalhofstraße 95, 94032 Passau." noindex>
  <PageHeader title="Impressum" />
  <div class="container-page py-12 sm:py-16">
    <div class="prose-legal mx-auto max-w-3xl">
      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        {site.name}<br />
        Inhaber: {site.legal.owner}<br />
        Rechtsform: {site.legal.legalForm}<br />
        {site.address.street}<br />
        {site.address.zip} {site.address.city}
      </p>

      <h2>Kontakt</h2>
      <p>Telefon: <a href={telHref}>{site.phone.display}</a><br />E-Mail: <a href={mailHref}>{site.email}</a></p>

      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>{site.legal.owner}<br />Anschrift wie oben</p>

      <h2>Verbraucherstreitbeilegung</h2>
      <p>Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
    </div>
  </div>
</Layout>
