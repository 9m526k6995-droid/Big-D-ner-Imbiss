---
import Base from "../layouts/Base.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Standort from "../components/Standort.astro";
import Icon from "../components/Icon.astro";
import { site, telHref, mailHref } from "../config/site";

const wege = [
  { icon: "phone" as const, titel: "Anrufen & vorbestellen", text: site.telefon.anzeige, href: telHref, extern: false },
  { icon: "mail" as const, titel: "E-Mail", text: site.email, href: mailHref, extern: false },
  { icon: "facebook" as const, titel: "Facebook", text: "Big Döner auf Facebook", href: site.facebook, extern: true },
  { icon: "route" as const, titel: "Route", text: `${site.adresse.strasse}, ${site.adresse.ort}`, href: site.route, extern: true },
];
---

<Base title="Kontakt & Anfahrt | Big Döner Imbiss Passau" description="Big Döner Imbiss, Spitalhofstraße 95, 94032 Passau – gegenüber PaWo-Center. Telefon 0177 8780402, Öffnungszeiten, Route und kostenlose Parkplätze.">
  <Seitenkopf eyebrow="Kontakt" titel="Ruf an, wir legen los" text="Am schnellsten geht es telefonisch: Bestellung durchgeben, kurz warten, abholen." />
  <section class="bg-paper py-12 sm:py-16">
    <ul class="container-x grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {wege.map((w) => (
        <li>
          <a href={w.href} target={w.extern ? "_blank" : undefined} rel={w.extern ? "noopener" : undefined} class="group flex h-full flex-col gap-4 rounded-3xl bg-white p-6 shadow-card ring-1 ring-line transition hover:-translate-y-0.5 hover:ring-ink/30">
            <span class="grid h-12 w-12 place-items-center rounded-full bg-red/10 text-red transition group-hover:bg-red group-hover:text-white"><Icon name={w.icon} /></span>
            <span><span class="block font-semibold">{w.titel}</span><span class="break-words text-muted">{w.text}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <Standort />
</Base>
