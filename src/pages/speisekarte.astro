---
import Base from "../layouts/Base.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Gericht from "../components/Gericht.astro";
import Icon from "../components/Icon.astro";
import { speisekarte, zusatzstoffeLegende, allergeneLegende, speisekarteHinweis, speisekarteStand } from "../data/speisekarte";
import { site, telHref } from "../config/site";

const kategorien = speisekarte.filter((k) => k.gerichte.length > 0); // leere Kategorien ausblenden
const zusatz = Object.entries(zusatzstoffeLegende);
const allergene = Object.entries(allergeneLegende);
---

<Base title="Speisekarte | Big Döner Imbiss Passau" description="Speisekarte von Big Döner in Passau: Döner, Dürüm, Döner-Box, Pizza, Pide, Lahmacun, Falafel, Baklava und Getränke. Telefonisch vorbestellen.">
  <Seitenkopf eyebrow="Speisekarte" titel="Frisch gemacht, schnell bestellt" text="Ruf an, sag uns, was du möchtest, und hol es ab, wenn es fertig ist.">
    <a href={telHref} class="btn btn-red mt-8"><Icon name="phone" />Jetzt telefonisch vorbestellen</a>
  </Seitenkopf>

  <!-- Kategorie-Navigation: wischbar, klebt unter dem Header -->
  <nav aria-label="Kategorien" class="sticky top-16 z-30 border-b border-line bg-paper/95 backdrop-blur">
    <div class="container-x">
      <div class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 py-3 sm:mx-0 sm:px-0">
        {kategorien.map((k) => (
          <a data-kat-link href={`#${k.id}`} class="shrink-0 rounded-full px-4 py-2 text-sm font-semibold text-muted transition hover:text-ink data-[aktiv]:bg-ink data-[aktiv]:text-white">{k.titel}</a>
        ))}
      </div>
    </div>
  </nav>

  <div class="container-x py-12 sm:py-16">
    {speisekarteHinweis && (
      <p class="mb-10 flex items-start gap-3 rounded-2xl bg-sand p-5 text-[15px] leading-relaxed">
        <Icon name="phone" class="mt-0.5 h-5 w-5 shrink-0 text-red" />
        <span>{speisekarteHinweis} <a href={telHref} class="font-semibold text-red-dark underline underline-offset-2">{site.telefon.anzeige}</a></span>
      </p>
    )}

    <div class="grid gap-14 lg:grid-cols-2 lg:gap-x-16">
      {kategorien.map((k) => (
        <section id={k.id} class:list={["scroll-mt-36", k.spalten?.length || k.gerichte.length > 8 ? "lg:col-span-2" : ""]} aria-labelledby={`t-${k.id}`}>
          <div class="flex items-end justify-between gap-4 border-b-2 border-ink pb-3">
            <div>
              <h2 id={`t-${k.id}`} class="text-4xl sm:text-5xl">{k.titel}</h2>
              {k.untertitel && <p class="mt-1 text-[15px] text-muted">{k.untertitel}</p>}
            </div>
          </div>
          {k.spalten?.length ? (
            <div class="mt-3 hidden gap-x-6 text-right text-xs font-semibold uppercase tracking-wider text-muted sm:grid" style={`grid-template-columns: 1fr repeat(${k.spalten.length}, 6.5rem)`} aria-hidden="true">
              <span></span>
              {k.spalten.map((s) => <span>{s}</span>)}
            </div>
          ) : null}
          <ul class:list={["divide-y divide-line", k.gerichte.length > 8 && !k.spalten?.length && "lg:columns-2 lg:gap-x-16 lg:divide-y-0 [&>li]:break-inside-avoid lg:[&>li]:border-b lg:[&>li]:border-line"]}>
            {k.gerichte.map((g) => <Gericht g={g} spalten={k.spalten} />)}
          </ul>
          {k.hinweis && <p class="mt-3 text-sm text-muted">{k.hinweis}</p>}
        </section>
      ))}
    </div>

    <footer class="mt-16 grid gap-8 border-t border-line pt-8 text-sm text-muted md:grid-cols-2">
      <div class="space-y-1">
        <p class="font-semibold text-ink">Preise inkl. MwSt. Änderungen vorbehalten.</p>
        {speisekarteStand && <p>{speisekarteStand}</p>}
        {site.halal && <p>Unser Fleisch ist halal.</p>}
      </div>
      {(zusatz.length > 0 || allergene.length > 0) && (
        <div class="grid gap-6 sm:grid-cols-2">
          {zusatz.length > 0 && <dl><dt class="mb-2 font-semibold text-ink">Zusatzstoffe</dt>{zusatz.map(([k, v]) => <dd><sup>{k}</sup> {v}</dd>)}</dl>}
          {allergene.length > 0 && <dl><dt class="mb-2 font-semibold text-ink">Allergene</dt>{allergene.map(([k, v]) => <dd><sup>{k}</sup> {v}</dd>)}</dl>}
        </div>
      )}
    </footer>
  </div>
</Base>
