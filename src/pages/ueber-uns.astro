---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Pic from '../components/Pic.astro';
import Team from '../components/Team.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { routeUrl } from '../lib/site-helpers';

const points = [
  { icon: 'bread', title: 'Frisches Brot', text: 'Unser Brot backen wir jeden Tag frisch – das loben auch unsere Gäste.' },
  { icon: 'heart', title: 'Freundlich', text: 'Bei uns wird man herzlich empfangen. Fragen zur Karte beantworten wir gern.' },
  { icon: 'check', title: 'Halal', text: 'Unsere Fleischspieße bestehen aus Hühner- und Putenfleisch.' },
  { icon: 'parking', title: 'Kostenlos parken', text: 'Parkplätze direkt am Imbiss, gegenüber dem PaWo-Center.' },
];
---

<Layout
  title="Über uns | Big Döner Imbiss in Passau, gegenüber PaWo-Center"
  description="Big Döner Imbiss in der Spitalhofstraße 95 in Passau: täglich frisch gebackenes Brot, Fleischspieße aus Hühner- und Putenfleisch, halal, kostenlose Parkplätze."
>
  <PageHeader eyebrow="Über uns" title="Big Döner in der Spitalhofstraße" />

  <section class="section">
    <div class="container-page grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="space-y-5 text-lg leading-relaxed text-ink-700">
        <p>
          Big Döner Imbiss liegt in der Spitalhofstraße 95 in Passau, direkt gegenüber dem PaWo-Center. Unser Imbiss mit dem roten Dach ist leicht zu finden, und parken könnt ihr bei uns kostenlos.
        </p>
        <p>
          Bei uns gibt es Döner und Dürüm, Pizza, Pide, Lahmacun und Falafel. Das Brot backen wir jeden Tag frisch, unsere Fleischspieße bestehen aus Hühner- und Putenfleisch – halal.
        </p>
        <p>
          Pizza und Pide brauchen ein bisschen Zeit im Ofen. Ruft am besten vorher an, dann ist euer Essen fertig, wenn ihr kommt.
        </p>
        <p>Wir freuen uns auf euch.</p>
        <div class="flex flex-col gap-3 pt-3 sm:flex-row">
          <Button href="/speisekarte" icon="utensils">Zur Speisekarte</Button>
          <Button href={routeUrl} variant="ghost" icon="route" external>Route planen</Button>
        </div>
      </div>
      <Pic datei="aussen-02.jpg" alt={`${site.name} in der Spitalhofstraße 95 in Passau`} sizes="(min-width:1024px) 560px, 100vw" class="block aspect-[4/3] overflow-hidden rounded-2xl bg-cream-200" imgClass="h-full w-full object-cover" position="50% 40%" priority />
    </div>
  </section>

  <section class="bg-cream-50 py-14 sm:py-20" aria-label="Das erwartet euch">
    <div class="container-page">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {points.map((p) => (
          <li class="card reveal p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink-900 text-gold-400"><Icon name={p.icon} class="h-5 w-5" /></span>
            <h2 class="mt-4 text-xl">{p.title}</h2>
            <p class="mt-1.5 text-[0.95rem] text-ink-600">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Team />
</Layout>
