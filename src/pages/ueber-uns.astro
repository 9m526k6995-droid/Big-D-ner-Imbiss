---
import Base from "../layouts/Base.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import Foto from "../components/Foto.astro";
import Icon from "../components/Icon.astro";
import { team } from "../data/team";
import { telHref } from "../config/site";

const werte = [
  { t: "Frisch gebackenes Brot", x: "Das Brot für Döner und Dürüm kommt bei uns stets frisch aus dem Ofen. Das schmeckt man." },
  { t: "Frische Zutaten", x: "Salat, Tomaten, Zwiebeln und Kraut liegen frisch an der Theke. Der Spieß ist aus Hühner- und Putenfleisch." },
  { t: "Freundlich & schnell", x: "Kurz bestellen, kurz warten, gut essen. Und gern ein paar nette Worte dazu." },
];
---

<Base title="Über uns | Big Döner Imbiss Passau" description="Big Döner in Passau: ein Pavillon mit rotem Dach an der Spitalhofstraße, frisch gebackenes Brot und ein freundliches Team. Lerne uns kennen.">
  <Seitenkopf eyebrow="Über uns" titel="Ein Imbiss, wie er sein soll" text="Frisches Brot, frische Zutaten, freundliche Gesichter. Mehr braucht es nicht, aber weniger soll es auch nicht sein." />

  <section class="section bg-paper">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal aspect-[4/3] overflow-hidden rounded-[2rem] shadow-card">
        <Foto datei="team-pizza.jpg" alt="Der Inhaber belegt lächelnd eine Pizza in der Küche" sizes="(min-width: 1024px) 560px, 100vw" position="50% 35%" />
      </div>
      <div class="reveal">
        <p class="eyebrow">Unser Laden</p>
        <h2 class="h2">Der Pavillon mit dem roten Dach</h2>
        <div class="mt-5 space-y-4 text-lg leading-relaxed text-muted">
          <p>Du findest uns in einem eigenen Pavillon direkt an der Spitalhofstraße, gegenüber vom PaWo-Center. Parken ist kostenlos, der Weg zur Theke kurz.</p>
          <p>Bei uns gibt es Döner und XL-Döner, Dürüm, Döner-Box und Dönerteller, dazu Pizza, Pide, Lahmacun und Falafel. Und zum Schluss gern ein Stück Baklava.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-ink text-white">
    <div class="container-x">
      <h2 class="h2 reveal">Darauf kannst du dich verlassen</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {werte.map((w, i) => (
          <li class="reveal rounded-3xl bg-ink-soft p-7 ring-1 ring-white/10" style={`--d:${i * 80}ms`}>
            <span class="font-display text-5xl text-red">0{i + 1}</span>
            <h3 class="mt-4 text-3xl">{w.t}</h3>
            <p class="mt-3 leading-relaxed text-white/75">{w.x}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-paper" id="team">
    <div class="container-x">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Team</p>
        <h2 class="h2">Die Gesichter hinter der Theke</h2>
      </div>
      <!-- Teammitglieder: src/data/team.ts -->
      <ul class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
        {team.map((m, i) => (
          <li class="reveal" style={`--d:${i * 70}ms`}>
            <div class="aspect-[3/4] overflow-hidden rounded-2xl shadow-card">
              <Foto datei={m.datei} alt={m.alt} position={m.position} sizes="(min-width: 1024px) 270px, 50vw" platzhalter="Foto folgt – Team" />
            </div>
            <p class="mt-3 font-semibold">{m.name}</p>
            <p class="text-sm text-muted">{m.rolle}</p>
          </li>
        ))}
      </ul>
      <div class="reveal mt-14 flex flex-col items-start gap-4 rounded-3xl bg-sand p-8 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-display text-3xl uppercase tracking-wide">Hunger? Wir sind gleich da.</p>
        <a href={telHref} class="btn btn-red"><Icon name="phone" />Jetzt telefonisch vorbestellen</a>
      </div>
    </div>
  </section>
</Base>
